# Local development only; generate independent secrets for deployed environments.
APP_NAME=Group Travel Planner
APP_ENV=development
POSTGRES_USER=travel
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=travel
POSTGRES_PORT=5432
# Host URL; Compose overrides the host to db for its backend container.
DATABASE_URL=postgresql+psycopg://travel:local-development-only@localhost:5432/travel
JWT_SECRET=replace-with-a-random-secret-before-deployment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=false
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SESSION_MAX_DAYS=30
JWT_REFRESH_WINDOW_SECONDS=60
# Enable the bundled Redis for a fresh local setup; omit this profile for an external server.
COMPOSE_PROFILES=local-redis
# Local Redis service in root compose.yaml; override both URLs for an external server.
REDIS_PASSWORD=local-redis-development-only
REDIS_PORT=6379
REDIS_URL=redis://:local-redis-development-only@localhost:6379/0
# Container URL when opting into --profile local-redis.
REDIS_URL_DOCKER=redis://:local-redis-development-only@redis:6379/0
REDIS_KEY_PREFIX=travel:auth:refresh:
REDIS_TIMEOUT_SECONDS=2
# Each API worker safely retries overdue polls; no public close endpoint.
POLL_SCHEDULER_ENABLED=true
POLL_SCHEDULER_INTERVAL_SECONDS=5
# Email transport and temporary test event (see docs/email-notifications.md).
EMAIL_ENABLED=false
EMAIL_TEST_ENABLED=false
EMAIL_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME=Group Travel Planner
# Hostinger Email; replace sender/username with your actual mailbox before enabling.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# starttls (usually 587), ssl (usually 465), none (local capture only)
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
# JSON array of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
# Public browser value: never put secrets in VITE_* variables.
VITE_API_URL=http://localhost:8000/api/v1

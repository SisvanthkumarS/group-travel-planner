# Local development only; generate independent secrets for deployed environments.
APP_NAME=Group Travel Planner
APP_ENV=development
POSTGRES_USER=travel
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=travel_test
POSTGRES_PORT=5432
# Host URL; Compose overrides the host to db for its backend container.
DATABASE_URL=postgresql+psycopg://travel:local-development-only@localhost:5432/travel_test
JWT_SECRET=replace-with-a-random-secret-before-deployment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_COOKIE_NAME=access_token
# Set true when serving over HTTPS in deployed environments.
JWT_COOKIE_SECURE=false
# JSON array of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
# Public browser value: never put secrets in VITE_* variables.
VITE_API_URL=http://localhost:8000/api/v1
